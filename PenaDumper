-- Filter & Search logic
_G.PenaDump_ApplyFilters = function()
    local query = State.SearchQuery:lower()
    table.clear(State.FilteredScripts)

    for _, data in ipairs(State.Scripts) do
        local typeMatch = (State.FilterType == "All") or (data.ClassName == State.FilterType)
        if typeMatch then
            if query == "" or data.Name:lower():find(query, 1, true) or data.PathString:lower():find(query, 1, true) then
                table.insert(State.FilteredScripts, data)
            end
        end
    end

    renderList()
    StatusLabel.Text = string.format("Found %d scripts (Total: %d)", #State.FilteredScripts, #State.Scripts)
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    State.SearchQuery = SearchBox.Text
    _G.PenaDump_ApplyFilters()
end)

-- Hierarchy Scanner (Full Game, Nil-Parented & Loaded Instances)
local function scanHierarchy()
    table.clear(State.Scripts)
    State.SelectedScript = nil
    StatusLabel.Text = "Scanning full game hierarchy and instances..."

    -- Blacklist of garbage paths and names that provide zero value
    local IgnoredContainers = {
        ["CorePackages"] = true,
        ["CoreGui"] = true,
        ["RobloxReplicatedStorage"] = true,
        ["ChatServiceRunner"] = true,
        ["PlayerScriptsLoader"] = true,
        ["RbxCharacterSounds"] = true,
        ["PlayerModule"] = true,
        ["Freecam"] = true,
        ["BubbleChat"] = true,
        ["ClientChat"] = true,
    }

    local localPlayer = game:GetService("Players").LocalPlayer
    local playersService = game:GetService("Players")

    local foundInstances = {}
    local function registerScript(obj)
        if not obj or foundInstances[obj] then return end
        local isTargetClass = false
        pcall(function()
            if obj:IsA("ModuleScript") or obj:IsA("LocalScript") or obj:IsA("Script") then
                isTargetClass = true
            end
        end)
        if not isTargetClass then return end

        local objName = tostring(obj.Name or "")
        if IgnoredContainers[objName] then return end

        -- If inside Players, only allow LocalPlayer's scripts
        local isOtherPlayer = false
        pcall(function()
            if obj:IsDescendantOf(playersService) then
                if not localPlayer or not obj:IsDescendantOf(localPlayer) then
                    isOtherPlayer = true
                end
            end
        end)
        if isOtherPlayer then return end

        foundInstances[obj] = true

        local pathSegs = {}
        local pathString = ""
        local hasIgnoredParent = false

        local okPath = pcall(function()
            pathSegs = getInstancePath(obj)
            for _, seg in ipairs(pathSegs) do
                if IgnoredContainers[seg] then
                    hasIgnoredParent = true
                    break
                end
            end
            if #pathSegs == 0 or not obj.Parent then
                pathSegs = {"NilInstances", sanitizeSegment(obj.Name)}
            end
            pathString = table.concat(pathSegs, ".")
        end)

        if hasIgnoredParent then return end

        if not okPath or #pathSegs == 0 then
            pathSegs = {"UnknownParent", sanitizeSegment(tostring(obj))}
            pathString = table.concat(pathSegs, ".")
        end

        table.insert(State.Scripts, {
            Instance = obj,
            Name = objName == "" and "UnnamedScript" or objName,
            ClassName = tostring(obj.ClassName or "Script"),
            Segments = pathSegs,
            PathString = pathString
        })
    end

    -- 1. Scan direct game descendants (all accessible services)
    pcall(function()
        for _, child in ipairs(game:GetChildren()) do
            local cName = child.Name
            if not IgnoredContainers[cName] then
                pcall(function()
                    if child == playersService then
                        -- Only scan LocalPlayer inside Players service
                        if localPlayer then
                            registerScript(localPlayer)
                            for _, desc in ipairs(localPlayer:GetDescendants()) do
                                registerScript(desc)
                            end
                        end
                    else
                        registerScript(child)
                        for _, desc in ipairs(child:GetDescendants()) do
                            registerScript(desc)
                        end
                    end
                end)
            end
        end
    end)

    -- 2. Scan getinstances / get_instances if supported by environment
    local env_getinstances = getfenv().getinstances or (getgenv and getgenv().getinstances)
    if env_getinstances then
        pcall(function()
            for _, inst in ipairs(env_getinstances()) do
                registerScript(inst)
            end
        end)
    end

    -- 3. Scan getnilinstances / get_nil_instances if supported
    local env_getnilinstances = getfenv().getnilinstances or (getgenv and getgenv().getnilinstances) or getfenv().get_nil_instances or (getgenv and getgenv().get_nil_instances)
    if env_getnilinstances then
        pcall(function()
            for _, inst in ipairs(env_getnilinstances()) do
                registerScript(inst)
            end
        end)
    end

    -- 4. Scan LocalPlayer if not caught
    pcall(function()
        local player = game:GetService("Players").LocalPlayer
        if player then
            for _, desc in ipairs(player:GetDescendants()) do
                registerScript(desc)
            end
        end
    end)

    _G.PenaDump_ApplyFilters()
end

RefreshBtn.MouseButton1Click:Connect(function()
