-- Fetch & Sanitize Game Name
task.spawn(function()
    local success, productInfo = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId)
    end)
    if success and productInfo and productInfo.Name then
        local raw = productInfo.Name:gsub('[\\/:*?"<>|%c]', "_"):gsub("^%s*(.-)%s*$", "%1")
        if #raw > 0 then
            State.SanitizedGameName = raw
        end
    end
end)

-- Path & String sanitization
local function sanitizeSegment(segment)
    local cleaned = segment:gsub('[\\/:*?"<>|%c]', "_")
    return cleaned == "" and "unnamed" or cleaned
end

-- Resolve full hierarchy path for instance
local function getInstancePath(inst)
    local segments = {}
    local curr = inst
    while curr and curr ~= game do
        table.insert(segments, 1, sanitizeSegment(curr.Name))
        curr = curr.Parent
    end
    return segments
end

-- Directory cache to prevent thousands of disk IO checks
local FolderCache = {}
local function ensureDirectoryChain(segments)
    if not env_makefolder then return end
    local currentPath = ""
    for _, segment in ipairs(segments) do
        currentPath = (currentPath == "") and segment or (currentPath .. "/" .. segment)
        if not FolderCache[currentPath] then
            local exists = false
            if env_isfolder then
                local ok, res = pcall(env_isfolder, currentPath)
                exists = ok and res
            end
            if not exists then
                pcall(env_makefolder, currentPath)
            end
            FolderCache[currentPath] = true
        end
    end
end

