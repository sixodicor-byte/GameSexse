local FilterChips = {}
local filterOptions = {"All", "ModuleScript", "LocalScript"}

local function updateFilterChips()
    for name, btn in pairs(FilterChips) do
        local active = (State.FilterType == name)
        local targetBg = active and Colors.Accent or Colors.Surface
        local targetText = active and Color3.fromRGB(255, 255, 255) or Colors.TextMuted
        local targetStroke = active and Colors.AccentGlow or Colors.BorderSubtle
        tween(btn, TweenInfo.new(0.15), {BackgroundColor3 = targetBg})
        tween(btn.TextLabel, TweenInfo.new(0.15), {TextColor3 = targetText})
        if btn:FindFirstChild("UIStroke") then
            tween(btn.UIStroke, TweenInfo.new(0.15), {Color = targetStroke})
        end
    end
end

for i, opt in ipairs(filterOptions) do
    local chip = Instance.new("TextButton")
    chip.Size = UDim2.new(0, opt == "All" and 54 or (opt == "ModuleScript" and 106 or 94), 1, 0)
    chip.Position = UDim2.new(0, (i == 1 and 0 or (i == 2 and 60 or 172)), 0, 0)
    chip.BackgroundColor3 = (opt == State.FilterType) and Colors.Accent or Colors.Surface
    chip.BorderSizePixel = 0
    chip.AutoButtonColor = false
    chip.Text = ""
    chip.Parent = FilterBar

    local cCorner = Instance.new("UICorner")
    cCorner.CornerRadius = UDim.new(0, 7)
    cCorner.Parent = chip

    local cStroke = Instance.new("UIStroke")
    cStroke.Color = (opt == State.FilterType) and Colors.AccentGlow or Colors.BorderSubtle
    cStroke.Thickness = 1
    cStroke.Parent = chip

    local cLabel = Instance.new("TextLabel")
    cLabel.Size = UDim2.new(1, 0, 1, 0)
    cLabel.BackgroundTransparency = 1
    cLabel.Font = Enum.Font.GothamMedium
    cLabel.Text = (opt == "ModuleScript" and "📦 Modules" or (opt == "LocalScript" and "⚡ Locals" or "✨ All"))
    cLabel.TextColor3 = (opt == State.FilterType) and Color3.fromRGB(255, 255, 255) or Colors.TextMuted
    cLabel.TextSize = 11
    cLabel.Parent = chip

    FilterChips[opt] = chip

    chip.MouseButton1Click:Connect(function()
        State.FilterType = opt
        updateFilterChips()
        _G.PenaDump_ApplyFilters()
    end)
end

