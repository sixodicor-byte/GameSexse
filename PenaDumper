    end
end)

-- Fast line counter: checks if string has at least minLines non-empty lines without gmatch table churn
local function hasMinLines(str, minLines)
    local count = 0
    local len = #str
    local i = 1
    while i <= len do
        local lineEnd = str:find("[\r\n]", i) or (len + 1)
        local sub = str:sub(i, lineEnd - 1)
        if sub:find("%S") then
            count = count + 1
            if count >= minLines then
                return true
            end
        end
        if lineEnd > len then break end
        if str:byte(lineEnd) == 13 and str:byte(lineEnd + 1) == 10 then
            i = lineEnd + 2
        else
            i = lineEnd + 1
        end
    end
    return count >= minLines
end

-- Decompiler & File System Dumper
local function dumpScript(scriptData)
    if not env_writefile then
        return false, "writefile is not supported in this environment."
    end

    local rootFolder = "PenaDump_" .. State.SanitizedGameName
    local folderSegments = { rootFolder }
    for i = 1, #scriptData.Segments - 1 do
        table.insert(folderSegments, scriptData.Segments[i])
    end

    -- Ensure all parent folders exist (instant from memory cache)
    ensureDirectoryChain(folderSegments)

    local fileName = sanitizeSegment(scriptData.Name) .. ".lua"
    local fullFilePath = table.concat(folderSegments, "/") .. "/" .. fileName

    -- Decompile with pcall
    local codeContent = ""
    local decompileOk, decompileResult = pcall(function()
        if env_decompile then
            return env_decompile(scriptData.Instance)
        else
            return "-- [Decompilation Failed: decompile function not found in environment]"
        end
    end)

    if decompileOk and type(decompileResult) == "string" and #decompileResult > 0 then
        if not hasMinLines(decompileResult, 5) then
            return false, "Skipped (less than 5 lines)"
        end
        codeContent = string.format("-- PenaDump: %s (%s)\n-- Path: %s\n\n%s", scriptData.Name, scriptData.ClassName, scriptData.PathString, decompileResult)
    else
        local err = tostring(decompileResult or "Unknown decompile error")
        codeContent = string.format("-- [Decompilation Failed: %s]\n-- Target: %s\n-- Class: %s", err, scriptData.PathString, scriptData.ClassName)
    end

    local writeOk, writeErr = pcall(function()
        env_writefile(fullFilePath, codeContent)
    end)

    return writeOk, writeErr or fullFilePath
end

-- Dump Single Handler
DumpSelectedBtn.MouseButton1Click:Connect(function()
    if State.IsDumping then return end
    if not State.SelectedScript then
        StatusLabel.Text = "Please select a script from the list first."
        return
    end

    State.IsDumping = true
    StatusLabel.Text = "Dumping: " .. State.SelectedScript.Name .. "..."
    ProgressBarFill.Size = UDim2.new(0.5, 0, 1, 0)

    task.spawn(function()
        local ok, res = dumpScript(State.SelectedScript)
        ProgressBarFill.Size = UDim2.new(1, 0, 1, 0)
        if ok then
            StatusLabel.Text = "Dumped: " .. State.SelectedScript.Name
        else
            StatusLabel.Text = "Result: " .. tostring(res)
        end
        task.wait(1)
        ProgressBarFill.Size = UDim2.new(0, 0, 1, 0)
        State.IsDumping = false
    end)
end)

-- Ultra-Fast Batch Dump All Handler
DumpAllBtn.MouseButton1Click:Connect(function()
    if State.IsDumping then
        State.ShouldCancel = true
        DumpAllBtn.Text = "Canceling..."
        return
    end

    local total = #State.FilteredScripts
    if total == 0 then
        StatusLabel.Text = "No scripts matching current filter to dump."
        return
    end

    State.IsDumping = true
    State.ShouldCancel = false
    DumpAllBtn.Text = "Cancel Dump"
    tween(DumpAllBtn, TweenInfo.new(0.15), {BackgroundColor3 = Colors.Red})

    task.spawn(function()
        local successCount = 0
        local failCount = 0
        local skippedCount = 0
        local BATCH_SIZE = 50 -- Process 50 scripts before updating UI / yielding

        local startTime = os.clock()

        for idx = 1, total do
            if State.ShouldCancel then
                StatusLabel.Text = string.format("Dump canceled. (%d saved, %d skipped)", successCount, skippedCount)
                break
            end

            local scriptData = State.FilteredScripts[idx]
            local ok, errReason = dumpScript(scriptData)
            if ok then
                successCount = successCount + 1
            elseif errReason and tostring(errReason):find("Skipped") then
                skippedCount = skippedCount + 1
            else
                failCount = failCount + 1
            end

            -- Update UI and yield every batch to avoid FPS lag while maintaining max throughput
            if idx % BATCH_SIZE == 0 or idx == total then
                local percent = idx / total
                ProgressBarFill.Size = UDim2.new(percent, 0, 1, 0)
                StatusLabel.Text = string.format("[%d/%d] Speed: %.0f/s | %s", idx, total, idx / math.max(os.clock() - startTime, 0.001), scriptData.Name)
                task.wait()
            end
        end

        local elapsed = math.max(os.clock() - startTime, 0.001)
        ProgressBarFill.Size = UDim2.new(1, 0, 1, 0)
        StatusLabel.Text = string.format("Done in %.2fs! Saved: %d, Skipped: %d, Failed: %d (%.0f/s)", elapsed, successCount, skippedCount, failCount, total / elapsed)

        DumpAllBtn.Text = "Dump All (Filtered)"
        tween(DumpAllBtn, TweenInfo.new(0.15), {BackgroundColor3 = Colors.Accent})
        State.IsDumping = false
        State.ShouldCancel = false
    end)
end)

